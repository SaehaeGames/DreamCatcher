  dataList:
  - id: SO_5000
    title: "\uD574\uAE08 \uD3B8\uC9C0"
    contents: "\uC548\uB155! \uC798 \uC9C0\uB0C8\uC5B4?nn nn\uADF8 \uC77C \uC774\uD6C4\uB85C
      \uC624\uB798\uB9CC\uC774\uB124!nn \uB124\uAC00 \uC0AC\uB77C\uC9C0\uACE0\uB098\uC11C
      \uC5BC\uB9C8\uB098 \uCC3E\uC544\uB2E4\uB154\uB294\uC9C0 \uBAB0\uB77C.nn nn\uC774\uC81C
      \uC758\uB8B0\uB294 \uD3B8\uC9C0\uB85C\uB9CC \uBC1B\uACE0nn \uC9D1 \uBC16\uC73C\uB85C
      \uC548 \uB098\uAC04\uB2E4\uBA70.nn \uADF8\uAC74 \uB124 \uACB0\uC815\uC774\uC57C?
      \uC544\uB2C8\uBA74 \uB098\uBE44\uC758 \uACB0\uC815?nn nn\uD639\uC2DC\uB098
      \uC758\uB8B0\uD560 \uB54C \uBB38\uC81C\uAC00 \uC0DD\uAE30\uBA74 \uB098\uD55C\uD14C
      \uD3B8\uC9C0 \uC368.nn \uB3C4\uC640\uC904\uAC8C, \uC6B0\uB9B0 \uCE5C\uAD6C\uB2C8\uAE4C!nn
      nn\uB0B4\uAC00 \uD574\uACB0 \uBABB \uD560 \uAC74 \uC5C6\uC5B4.nn \uBD10 \uC774\uB807\uAC8C
      \uB108\uB3C4 \uCC3E\uC544\uB0C8\uC796\uC544?nn nn \uB2E4\uC74C\uC5D0 \uB610
      \uD3B8\uC9C0\uD560\uAC8C!"
    from: "-\uB108\uC758 \uCE5C\uAD6C \uCE74\uB860"
    item: 
    note: "SO_9005\r"
  - id: SO_5001
    title: "\uC2E0\uAE30\uD55C \uC561\uCCB4 \uD3B8\uC9C0"
    contents: "\uC774\uB7F0, \uACE4\uB780\uD55C \uC77C\uC774 \uC0DD\uACBC\uAD6C\uB098!nn
      nn\uB098\uC600\uC73C\uBA74 \uC774\uAC78 \uBCF4\uB0B8 \uB188\uC744 \uBD88\uD0DC\uC6CC
      \uBC84\uB9B4 \uAC70\uC57C.nn \uB10C \uCC29\uD558\uB2C8\uAE4C \uC774\uB7F0 \uC758\uB8B0\uB3C4
      \uBC1B\uC544\uC8FC\uACA0\uC9C0?nn nn\uC9C0\uAE08\uC758 \uB108\uD55C\uD14C\uB294
      \uC774 \uBB3C\uAC74\uC774 \uD544\uC694\uD560 \uAC70 \uAC19\uB124.nn \uBD80\uD0C1\uD558\uAE30\uB3C4
      \uC804\uC5D0 \uBA3C\uC800 \uB3C4\uC640\uC8FC\uB294 \uB098 \uAC19\uC740 \uCE5C\uAD6C
      \uC5B4\uB528\uB2C8~nn nn\uB2E4\uC74C\uC5D0\uB3C4 \uC774\uC0C1\uD55C \uC758\uB8B0\uAC00
      \uB4E4\uC5B4\uC624\uBA74 \uB0B4\uAC8C \uB9D0\uD574.nn \uC0AC\uC2E4 \uC548 \uB9D0\uD574\uC918\uB3C4
      \uB3FC. \uB2E4 \uC544\uB2C8\uAE4C.nn \uC61C\uB0A0 \uC77C\uC740 \uC78A\uACE0
      \uC6B0\uB9AC \uB2E4\uC2DC \uCE5C\uD558\uAC8C \uC9C0\uB0B4\uC790.nn nn.... nn\uB108\uB294
      \uC774\uBBF8 \uC78A\uC5C8\uC73C\uB824\uB098?nn nnps. \uADF8 \uBB3C\uAC74\uC740
      \uBB50\uB4E0 \uC9C0\uC6CC \uC904 \uBFD0\uB9CC \uC544\uB2C8\uB77Cnn \uC228\uACA8\uC9C4
      \uAC83\uB4E4\uB3C4 \uBCF4\uC5EC \uC8FC\uB2C8\uAE4C.nn \uB124 \uAFC8 \uB3C4\uAC10\uC5D0
      \uC0AC\uC6A9\uD574 \uBD10. \uC0C8\uB85C\uC6B4 \uC120\uB4E4\uC774 \uBCF4\uC77C
      \uAC70\uC57C."
    from: "-\uC13C\uC2A4\uC788\uB294 \uCE5C\uAD6C \uCE74\uB860"
    item: ITEM_001
    note: "SO_9009\r"
  - id: SO_5002
    title: "\uBC88\uC5ED\uAE30 \uD3B8\uC9C0"
    contents: "\uC624\uB298 \uC18C\uAC1C\uD560 \uBB3C\uAC74\uC740 \uBC14\uB85C~nn
      \uBAA8\uB974\uB294 \uC5B8\uC5B4\uB97C \uBC88\uC5ED\uD574\uC8FC\uB294 \uBC88\uC5ED
      \uBB38\uC9C4!nn nn\uAC01\uAD6D \uC5B8\uC5B4\uBD80\uD130 \uB3CC\uACE0\uB798
      \uCD08\uC74C\uD30C\uAE4C\uC9C0 \uBC88\uC5ED\uD574 \uC900\uB2E4\uACE0!!nn \uC0AC\uC6A9\uBC95\uB3C4
      \uC26C\uC6CC, \uBC88\uC5ED\uD558\uACE0 \uC2F6\uC740 \uBD80\uBD84\uC5D0 \uBB38\uC9C4\uC744
      \uC5B9\uC5B4\uBD10.nn \uC774\uC81C \uD574\uB3C5\uD558\uC9C0 \uBABB\uD560 \uC758\uB8B0\uB294
      \uC5C6\uACA0\uB2E4~nn nn\uC774 \uD2B9\uBCC4\uD55C \uBB3C\uAC74\uC744 \uADF8\uB0E5
      \uC900\uB2E4\uB2C8...nn \uB098\uB3C4 \uB110 \uB2EE\uC544 \uAC00\uB098 \uBD10.nn
      nn\uADF8\uB9AC\uACE0 \uB610 \uC904\uAC8C \uC788\uC5B4!nn \uB0B4\uAC00 \uB0A1\uC740
      \uCC45 \uD558\uB098\uB97C \uBC1C\uACAC\uD588\uB294\uB370nn \uC138\uC0C1\uC5D0!
      \uB108\uB791 \uB098\uBE44 \uC774\uC57C\uAE30\uAC00 \uC801\uD78C\uAC70 \uC788\uC9C0!!nn
      nn\uB124 \uC77C\uAE30\uC778 \uAC70 \uAC19\uC740\uB370 \uC8FC\uC778\uC5D0\uAC8C
      \uB3CC\uB824\uC918\uC57C\uACA0\uB2E4 \uC2F6\uC5C8\uC9C0.nn \uADF8 '\uC0AC\uAC74'\uB3C4
      \uC801\uD600\uC788\uACE0 \uAE30\uC5B5\uC744 \uB5A0\uC62C\uB9AC\uB294\uB370
      \uB3C4\uC6C0\uC774 \uB420 \uAC70\uC57C.nn \uADF8\uB7FC \uB2E4\uC74C\uC5D0 \uB610\uBD10!nn
      nnps. \uB098\uBE44\uC57C \uC601\uC6D0\uD55C \uBE44\uBC00\uC740 \uC5C6\uC5B4."
    from: "-\uCE5C\uC808\uD55C \uCE5C\uAD6C \uCE74\uB860"
    item: ITEM_002
    note: "\r"
  - id: SO_5003
    title: "\uC5D4\uB529 \uD6C4 \uD3B8\uC9C0"
    contents: "\uC548\uB155! \uC5EC\uAE34 \uB124 \uBB34\uC758\uC2DD\uC774\uACE0 \uC9C0\uC6CC\uC9C4
      \uAE30\uC5B5\uC774\uC57C.nn \uC774\uACF3\uC5D0 \uB3CC\uC544\uC628 \uAC78 \uBCF4\uBA74
      \uB098\uBE44\uAC00 \uB9CE\uC774 \uADF8\uB9AC\uC6E0\uB098 \uBD10.nn nn\uB05D\uB09C
      \uC774\uC57C\uAE30\uB97C \uB2E4\uC2DC \uC77D\uB294\uB2E4 \uD574\uB3C4 \uB0B4\uC6A9\uC740
      \uB611\uAC19\uC740\uB370 \uB9D0\uC774\uC57C.nn\uB208 \uB728\uBA74 \uC774 \uAFC8,
      \uAE30\uC5B5 \uBABB\uD560 \uAC70\uB780\uAC70 \uC54C\uC9C0?nn nn.... nn\uBB50
      \uC5B4\uCA0C\uB4E0 \uC774\uAC8C \uB0B4 \uB9C8\uC9C0\uB9C9 \uD3B8\uC9C0\uC57C.nn\uB098\uC911\uC5D0
      \uC774\uACF3\uC5D0 \uC624\uBA74 \uB098\uBE44 \uB9D0\uACE0 \uB098\uB3C4 \uBCF4\uB7EC
      \uC640\uC918~nn \uC548\uB155:)"
    from: "-\uB108\uC758 \uCE5C\uAD6C\uAC00 \uB418\uACE0 \uC2F6\uC5C8\uB358 \uC800\uC2B9\uC0AC\uC790"
    item: 
    note: 
