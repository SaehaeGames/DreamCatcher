  dataList:
  - id: SO_9000
    contents: "\uCC98\uC74C\uC5D0\uB294 \uD63C\uB780\uC2A4\uB7EC\uC6E0\uB2E4.nn\uC544\uD514\uC744
      \uB290\uB084 \uC0C8 \uC5C6\uC774 \uC11C\uC11C\uD788 \uC758\uC2DD\uC744 \uC783\uC5B4\uAC14\uACE0nn\uB09C
      \uC8FD\uC74C\uC744 \uC9C1\uAC10\uD588\uB2E4.nn\uBD84\uBA85 \uADF8\uB807\uAC8C
      \uC0DD\uAC01\uD588\uB294\uB370...nn\uAE68\uC5B4\uB098\uB2C8 \uACE0\uC591\uC774
      \uD55C \uB9C8\uB9AC\uAC00 \uB0A0 \uBC14\uB77C\uBCF4\uACE0 \uC788\uC5C8\uB2E4.nn\uADF8\uB9AC\uACE0
      \uB9D0\uD588\uB2E4.nn nn\uC774\uACF3\uC740 \uC800\uC2B9\uC774\uB77C\uACE0.\r"
  - id: SO_9001
    contents: "\uC774\uACF3\uC740 \uC774\uC2B9\uACFC \uBCC4\uBC18 \uB2E4\uB974\uC9C0
      \uC54A\uC558\uB2E4.nn\uC8FD\uB358 \uC21C\uAC04\uC758 \uAE30\uC5B5\uB9CC \uC5C6\uC5C8\uB2E4\uBA74nn\uC5EC\uAE34
      \uD3C9\uBC94\uD55C \uC232\uC18D\uC774\uB77C \uC0DD\uAC01\uD588\uC744 \uAC83\uC774\uB2E4.nn
      nn\u2018\uC8FD\uC73C\uBA74 \uC800\uC2B9\uC5D0\uC11C \uAE38\uC7A1\uC774\uAC00
      \uB9C8\uC911\uC744 \uB098\uC628\uB2E4.\u2019nn\u2026.\uB77C\uB294 \uAC74 \uBBF8\uC2E0
      \uC778 \uC904 \uC54C\uC558\uB294\uB370nn\uB0B4\uAC8C\uB3C4 \uAE38\uC744 \uC54C\uB824\uC8FC\uB294
      \uACE0\uC591\uC774\uAC00 \uC788\uC5C8\uB2E4.nn nn\u2018\uB098\uBE44\u2019nn\uAE38\uC7A1\uC774
      \uACE0\uC591\uC774\uC758 \uC774\uB984\uC774\uB2E4.\r"
  - id: SO_9002
    contents: "\uB098\uBE44\uB294 \uB0B4\uAC8C \uC544\uC9C1 \uC62C \uB54C\uAC00 \uC544\uB2C8\uB77C
      \uB9D0\uD588\uB2E4.nn\uC601\uD63C\uC774 \uC544\uC9C1 \uC721\uCCB4\uC5D0 \uBB36\uC5EC\uC788\uB2E4\uBA70nn\uC774\uC2B9\uC73C\uB85C
      \uB3CC\uC544\uAC00\uACE0 \uC2F6\uB0D0\uACE0 \uBB3C\uC5C8\uB2E4.nn\uD63C\uC218\uC0C1\uD0DC\uB97C
      \uB9D0\uD558\uB294 \uAC83\uC77C\uAE4C.nn\uB2F9\uC5F0\uD788 \uB3CC\uC544\uAC00\uACE0
      \uC2F6\uB2E4.nn nn\uC544\uC9C1 \uB3D9\uC0DD\uC774 \uC9D1\uC5D0\uC11C \uB0A0
      \uAE30\uB2E4\uB9AC\uACE0 \uC788\uB2E4.nn\uC120\uBB3C\uC744 \uC0AC \uB4E4\uACE0
      \uAC00\uAE30\uB85C \uD588\uB294\uB370\u2026.\r"
  - id: SO_9003
    contents: "\uC9D1\uC73C\uB85C \uB3CC\uC544\uAC00\uB294 \uBC95nn\uAE68\uC5B4\uB098\uAE30
      \uC704\uD574\uC120 \uAFC8 \uAD6C\uC2AC\uC774 \uB9CE\uC774 \uD544\uC694\uD588\uB2E4.nn\uAFC8
      \uAD6C\uC2AC\uC740 \uB9DD\uC790\uB4E4\uC774 \uC8FD\uB358 \uC21C\uAC04\uC774\uB098nn\uC0DD\uC804\uC758
      \uD2B8\uB77C\uC6B0\uB9C8\uB97C \uC7A0\uACB0\uC5D0 \uB5A0\uC62C\uB9B0\uB2E4.nn\uADF8
      \uC545\uBABD\uC744 \uACB0\uC815\uCCB4\uB85C \uB9CC\uB4E0 \uAC83\uC774 \uAFC8
      \uAD6C\uC2AC\uC774\uB2E4.nn nn\uB098\uBE44\uC758 \uB3C4\uC6C0\uC73C\uB85C \uB4DC\uB9BC\uCE90\uCCD0\uB97C
      \uB9CC\uB4DC\uB294 \uBC29\uBC95\uC744 \uC775\uD614\uB2E4.nn\uB9DD\uC790\uB4E4\uC5D0\uAC8C
      \uB4DC\uB9BC\uCE90\uCCD0\uB97C \uB9CC\uB4E4\uC5B4\uC8FC\uB2E4 \uBCF4\uBA74.nn\uAFC8
      \uAD6C\uC2AC\uC744 \uAE08\uBC29 \uBAA8\uC744 \uC218 \uC788\uACA0\uC9C0?nn nn\uB3D9\uC0DD\uC774
      \uC798 \uC9C0\uB0B4\uACE0 \uC788\uC744\uC9C0 \uAC71\uC815\uC774\uB2E4.\r"
  - id: SO_9004
    contents: "\uD55C \uC800\uC2B9\uC0AC\uC790\uAC00 \uB0B4\uAC8C \uAD00\uC2EC\uC744
      \uBCF4\uC600\uB2E4.nn\u2018\uCE74\uB860\u2019\uC740 \uB0B4\uAC00 \uD765\uBBF8\uB86D\uB2E4\uACE0
      \uD588\uB2E4.nn\uC544\uBB34\uB798\uB3C4 \uB098 \uAC19\uC740 \uB9DD\uC790\uAC00
      \uD754\uCE58 \uC54A\uB098 \uBCF4\uB2E4.nn\uC774\uC2B9\uC73C\uB85C \uBABB \uAC00\uAC8C
      \uB418\uBA74 \uB098\uB97C \uB370\uB824\uAC00\uACE0 \uC2F6\uB2E4 \uB4E0\uC9C0.nn\u2026\u2026nn\uCE74\uB860\uC774
      \uBB34\uC2A8 \uC0DD\uAC01\uC744 \uD558\uB294 \uAC74\uC9C0 \uBAA8\uB974\uACA0\uB2E4.nn\uB098\uBE44\uB294
      \uCE74\uB860\uC744 \uC5C4\uCCAD\uB098\uAC8C \uACBD\uACC4\uD558\uACE0 \uC788\uB2E4.nn\uC800\uC2B9\uC0AC\uC790\uC640
      \uAE38\uC7A1\uC774\uB294 \uC6D0\uB798 \uC0AC\uC774\uAC00 \uC548 \uC88B\uB2E4\uACE0
      \uD588\uB2E4.\r"
  - id: SO_9005
    contents: "\uB0B4\uAC00 \uC758\uB8B0\uD574 \uC900 \uBA87\uBA87 \uB9DD\uC790\uB4E4\uC774nn\uB5A0\uB098\uAC00\uB294
      \uAC78 \uBD24\uB2E4...nn\uC8FD\uC74C\uC744 \uBC1B\uC544\uB4E4\uC774\uACE0 \uD658\uC0DD\uC744
      \uD558\uB7EC \uAC14\uB2E4.nn.nn\uB0B4\uAC00 \uC5EC\uAE30 \uBA38\uBB34\uB294
      \uC2DC\uAC04\uC774 \uAE38\uC5B4\uC9C8\uC218\uB85D.nn\uC810\uC810 \uBD88\uC548\uD574\uC838
      \uAC04\uB2E4.nn\uB09C \uC774\uC2B9\uC73C\uB85C \uB2E4\uC2DC \uB3CC\uC544\uAC08
      \uC218 \uC788\uC744\uAE4C?nn\uB9CC\uC57D \uB108\uBB34 \uC624\uB798\uB418\uC5B4\uC11C
      \uB3CC\uC544\uAC08 \uC218 \uC5C6\uB2E4\uBA74?nn\uB098\uB3C4 \uAE30\uC5B5\uC744
      \uC783\uACE0 \uC8FD\uC74C\uC744 \uBC1B\uC544\uB4E4\uC5EC\uC57C \uD558\uB294
      \uAC78\uAE4C?nn\uADF8\uB7F4 \uC218 \uC5C6\uB2E4.nn\uB3CC\uC544\uAC00\uC57C\uC9C0,
      \uB3CC\uC544\uAC08 \uC218 \uC788\uC5B4\u2026\r"
  - id: SO_9006
    contents: "\uAFC8 \uAD6C\uC2AC\uC744 \uAC70\uC758 \uB2E4 \uBAA8\uC544\uAC04\uB2E4.nn.nn.nn.nn\uC774\uC81C
      \uC9D1\uC73C\uB85C \uB3CC\uC544\uAC08 \uB0A0\uC774 \uC5BC\uB9C8 \uB0A8\uC9C0
      \uC54A\uC558\uB2E4.nn\uB098\uBE44 \uB355\uBD84\uC5D0 \uC5EC\uAE30\uAE4C\uC9C0
      \uC654\uB2E4.nn\uB0B4\uAC00 \uB5A0\uB098\uBA74 \uB098\uBE44\uAC00 \uC544\uC8FC
      \uADF8\uB9AC\uC6B8 \uAC70 \uAC19\uB2E4.\r"
  - id: SO_9007
    contents: "\uC624\uB298 \uBC29\uD669\uD558\uB294 \uD55C \uC544\uC774\uB97C \uB9CC\uB0AC\uB2E4.nn\uB0B4
      \uB3D9\uC0DD\uBCF4\uB2E4\uB3C4 \uC5B4\uB9B0 \uB4EF\uD588\uB294\uB370nn\uBCF4\uC790\uB9C8\uC790
      \uB098\uC640 \uAC19\uC740 \uBD80\uB958\uB77C\uB294\uAC78 \uB290\uAF08\uB2E4.nn\uC5B4\uB9B0
      \uB098\uC774\uC5D0 \uC5B4\uCA4C\uB2E4.\u2026 .nn\uD558\uC9C0\uB9CC \uB098\uC640
      \uB2EC\uB9AC \uC774 \uC544\uC774\uB294 \uD63C\uC790\uC600\uB2E4.nn nn\uC774\uB300\uB85C\uB294
      \uC5BC\uB9C8 \uC548 \uAC00 \uC601\uC601 \uB3CC\uC544\uAC08 \uC218 \uC5C6\uC744
      \uAC70 \uAC19\uB2E4.nn\uB0B4\uAC00 \uB3C4\uC640\uC904 \uBC29\uBC95\uC740 \uC5C6\uC744\uAE4C?\r"
  - id: SO_9008
    contents: "\uB3CC\uC544\uAC00\uAE30 \uC704\uD55C \uAFC8 \uAD6C\uC2AC \uAC1C\uC218\uB294
      \uB098\uC774\uC5D0 \uBE44\uB840\uD55C\uB2E4.nn\u2026\uACE0 \uC608\uC804\uC5D0
      \uCE74\uB860\uC774 \uB9D0\uD55C \uC801\uC774 \uC788\uB2E4.nn\uB9CC\uC57D \uC544\uC774\uB3C4
      \uB098\uCC98\uB7FC \uB418\uC0B4\uC544\uB0A0 \uC870\uAC74\uC774 \uAC19\uB2E4\uBA74.nn\uB0B4
      \uAD6C\uC2AC\uC744 \uC870\uAE08 \uB098\uB220\uC8FC\uB294 \uAC74 \uC5B4\uB5A8\uAE4C..nn
      nn\uC5B4\uB9B0 \uC544\uC774\uB2C8\uAE4C \uAD6C\uC2AC \uBA87 \uAC1C\uBA74 \uB420
      \uAC83\uC774\uB2E4.nn\uB09C \uC900 \uB9CC\uD07C \uB2E4\uC2DC \uC758\uB8B0\uB97C
      \uBC1B\uC544\uC11C \uBAA8\uC73C\uBA74 \uB420 \uAC83\uC774\uB2E4.\r"
  - id: SO_9009
    contents: ".nn.nn.nn\uC544\uC774\uB97C \uC0B4\uB9AC\uB294 \uB370 \uC2E4\uD328\uD588\uB2E4.nn\uAD6C\uC2AC\uC744
      \uC544\uBB34\uB9AC \uC0AC\uC6A9\uD574\uB3C4 \uAE68\uC9C4 \uB3C5\uC5D0 \uBB3C\uC744
      \uBD93\uB294 \uAC83 \uAC19\uC558\uB2E4.nn\uB098\uC640 \uB2EC\uB9AC \uC774\uBBF8
      \uB108\uBB34 \uB2A6\uC5B4\uBC84\uB9B0 \uAC70\uC600\uB2E4.nn\uC880 \uB354 \uBE68\uB790\uB2E4\uBA74
      \uAD6C\uD560 \uC218 \uC788\uC5C8\uC744\uAE4C\u2026nn\u2026\u2026 nn\uC228\uC774
      \uB9C9\uD788\uACE0 \uC628\uBAB8\uC5D0 \uD798\uC774 \uBE60\uC838\uB098\uAC00\uBA70nn\uC4F0\uB7EC\uC9C0\uAE30
      \uC804 \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uBCF8 \uAC74nn\uCE74\uB860\uC774 \uC6C3\uC73C\uBA70
      \uC544\uC774\uB97C \uB370\uB824\uAC00\uB294 \uBAA8\uC2B5\uC774\uC5C8\uB2E4.nn\uCC98\uC74C\uBD80\uD130
      \uBAA8\uB4E0 \uAC8C \uAC70\uC9D3\uB9D0\uC774\uC5C8\uC744 \uC9C0\uB3C4 \uBAA8\uB978\uB2E4.\r"
  - id: SO_9010
    contents: "\uB098\uBE44\uD558\uACE0 \uD06C\uAC8C \uC2F8\uC6B4 \uB4A4.nn\uD55C\uB3D9\uC548
      \uC6B8\uAC70\uB098 \uC7A0\uB9CC \uC7A4\uB2E4..nn\uB0B4 \uC0C1\uD0DC\uAC00 \uC870\uAE08
      \uC774\uC0C1\uD574 \uC84C\uB2E4...nn\uC81C\uBA4B\uB300\uB85C \uAD74\uC5C8\uB358
      \uC5C5\uBCF4\uC77C\uAE4C.nn\uB9C8\uCE58nn\u2026..nn\u2026\u2026nn\u2026\u2026\u2026..nn\uB0B4\uAC00
      \uBB34\uC2A8 \uB9D0\uC744 \uC4F0\uB824 \uD588\uB354\uB77C?\r"
  - id: SO_9011
    contents: "\uD655\uC2E4\uD788 \uAE30\uC5B5\uC744 \uC783\uC5B4\uAC00\uACE0 \uC788\uB2E4.nn\uC758\uB8B0\uC778\uC774
      \uB204\uAD6C\uC600\uB294\uC9C0 \uC78A\uC5B4\uBC84\uB9AC\uACE0nn\uC5B4\uC81C
      \uBB58 \uD588\uB294\uC9C0\uC870\uCC28 \uAE30\uC5B5\uB098\uC9C0 \uC54A\uC544\uC11C
      \uD63C\uB780\uC2A4\uB7EC\uC6E0\uB2E4....nn\uB098\uBE44\uB3C4 \uBCF4\uACE0 \uC788\uAE30
      \uAD34\uB85C\uC6E0\uB294\uC9C0 \uC870\uC2EC\uC2A4\uB7FD\uAC8C \uB9D0\uD588\uB2E4.nn\uC0C8\uB85C\uC6B4
      \uACF3\uC73C\uB85C \uC774\uC0AC\uB97C \uAC00\uC790\uACE0.nn\uC544\uBB34\uB3C4
      \uC5C6\uB294 \uC678\uC9C4 \uACF3\uC5D0\uC11C \uB098\uBA38\uC9C0 \uAD6C\uC2AC\uC744
      \uBAA8\uC73C\uC790\uACE0 \uB9D0\uC774\uB2E4.nn nn\uBB34\uC2A8 \uC77C\uC774
      \uC788\uC5B4\uB3C4nn\uC9D1\uC73C\uB85C \uB3CC\uB824 \uBCF4\uB0B4 \uC8FC\uACA0\uB2E4\uACE0
      \uB9D0\uD588\uB2E4.nn\uBBFF\uC74C\uC9C1\uD55C \uB0B4 \uCE5C\uAD6C. \uACE0\uB9C8\uC6CC\u2026\r"
  - id: SO_9012
    contents: "\uB0B4\uC77C\uC774\uBA74 \uC0C8\uB85C\uC6B4 \uC7A5\uC18C\uB85C \uAC08
      \uAC83\uC774\uB2E4. nn\uC774 \uC77C\uAE30\uC7A5\uB3C4 \uC5EC\uAE30 \uB194\uB450\uACE0
      \uAC00\uB824 \uD55C\uB2E4.nn\uACFC\uAC70\uC758 \uAE30\uC5B5\uC744 \uC644\uC804\uD788
      \uC783\uB294 \uAC83\uC774 \uB354 \uC88B\uC740 \uBC29\uBC95\uC77C\uC9C0\uB3C4
      \uBAA8\uB978\uB2E4.nn\uB2E4 \uC78A\uB294\uB2E4 \uD574\uB3C4 \uB098\uBE44\uB97C
      \uBBFF\uC73C\uB2C8\uAE4C \uAD1C\uCC2E\uB2E4.nn\uAD1C\uCC2E\uC744 \uAC70\uC57C\u2026."
